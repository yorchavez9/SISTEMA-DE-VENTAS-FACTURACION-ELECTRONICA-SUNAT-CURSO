# Copiar a .env y completar. .env NUNCA se versiona.

NODE_ENV=development
PORT=4000
# Origen permitido para la SPA (en desarrollo, el servidor de Vite)
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# MySQL 8 (Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_ventas

# Clave maestra para cifrar secretos en la BD (AES-256-GCM).
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENC_KEY=

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres)
SESSION_SECRET=

# Conexión con API-PRO (solo backend)
APIPRO_BASE_URL=https://sunat.kodevo.es/api/v1
APIPRO_KEY=
APIPRO_SECRET=
# Peticiones por minuto que el sistema se permite (el límite real verificado es 30)
APIPRO_PRESUPUESTO_RPM=25
