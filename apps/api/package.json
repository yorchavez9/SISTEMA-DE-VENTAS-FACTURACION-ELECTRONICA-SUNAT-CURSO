{
  "name": "@sv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:rendimiento": "vitest run --mode rendimiento src/modules/reportes/rendimiento.test.ts",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:rollback": "tsx src/database/cli.ts rollback",
    "db:seed": "tsx src/database/cli.ts seed",
    "respaldo": "tsx src/database/respaldo.ts respaldar",
    "respaldo:probar": "tsx src/database/respaldo.ts probar",
    "secretos:rotar": "tsx src/database/rotar-clave.ts",
    "apipro:probar": "tsx src/integrations/apiPro/probar.ts",
    "usuarios:crear-admin": "tsx src/database/crear-admin.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@sv/shared": "0.1.0",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
