# Plantilla de apps/api/.env para PRODUCCIÓN (manual de operación §1).
# Copiar a apps/api/.env en el servidor y completar. Nunca se versiona.
# La api se niega a arrancar si WEB_ORIGIN no es https, si usa root o una base *_test.

NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://ventas.example.com
LOG_LEVEL=info
# La api entrega también la pantalla (apps/web/dist): un solo proceso detrás de Apache.
SERVIR_WEB=true

# Usuario propio de MySQL con permisos solo sobre esta base:
#   CREATE USER 'ventas'@'localhost' IDENTIFIED BY '<contraseña larga>';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, DROP, REFERENCES, LOCK TABLES, TRIGGER, SHOW VIEW, EVENT
#     ON sistema_ventas.* TO 'ventas'@'localhost';
#   GRANT PROCESS ON *.* TO 'ventas'@'localhost';   -- para mysqldump --single-transaction
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ventas
DB_PASSWORD=
DB_NAME=sistema_ventas

# Clave maestra (32 bytes en base64). Distinta a la de desarrollo. Rotación: manual §5.
APP_ENC_KEY=
# Reservado (las sesiones son tokens aleatorios en la BD); se exige por compatibilidad.
SESSION_SECRET=

APIPRO_BASE_URL=https://sunat.kodevo.es/api/v1
# Recomendado: dejar vacías y registrar las credenciales desde Configuración → Empresa
# (se guardan cifradas con APP_ENC_KEY).
APIPRO_KEY=
APIPRO_SECRET=
APIPRO_PRESUPUESTO_RPM=25

# Respaldos
MYSQL_BIN=C:/laragon/bin/mysql/mysql-8.4.3-winx64/bin
# Mejor en otro disco o carpeta sincronizada fuera del servidor:
RESPALDO_DIR=D:/respaldos/sistema-ventas
RESPALDO_DIAS=30
